# =============================================================
# BinanceSpotManager V2 — configuration
# Copier ce fichier en ".env" et renseigner les valeurs.
# NE JAMAIS committer le fichier .env
# =============================================================

# -------------------------------------------------------------
# MODE D'EXECUTION
# DEMO  = Binance Spot Demo/Testnet (seul mode autorise actuellement)
# LIVE  = Binance Spot reel (VOLONTAIREMENT NON IMPLEMENTE EN V2)
# -------------------------------------------------------------
BSM_ENV=DEMO

# -------------------------------------------------------------
# Mode operationnel du bot
# DRY_RUN            : calcule tout, n'envoie AUCUN ordre
# DEMO_MANUAL        : Demo, chaque signal demande une confirmation manuelle (reglable dans Settings)
# DEMO_AUTO          : Demo, le worker agit automatiquement
# -------------------------------------------------------------
BSM_RUN_MODE=DRY_RUN

# -------------------------------------------------------------
# URL de base Binance DEMO
# Valeur par defaut = testnet Spot publique de Binance.
# Si ton compte utilise https://demo-api.binance.com, mets-le ici :
# la whitelist de securite accepte les deux, et RIEN d'autre.
# -------------------------------------------------------------
BSM_DEMO_BASE_URL=https://testnet.binance.vision

# Cles API DEMO (testnet.binance.vision -> "Generate HMAC_SHA256 Key")
BSM_DEMO_API_KEY=
BSM_DEMO_API_SECRET=

# -------------------------------------------------------------
# Cles LIVE — laisser VIDE. Aucune reutilisation des cles Demo.
# Le mode LIVE est bloque par le code en V2.
# -------------------------------------------------------------
BSM_LIVE_BASE_URL=https://demo-api.binance.com
BSM_LIVE_API_KEY=
BSM_LIVE_API_SECRET=

# -------------------------------------------------------------
# Reseau / signature
# -------------------------------------------------------------
BSM_RECV_WINDOW=5000
BSM_HTTP_TIMEOUT=10

# -------------------------------------------------------------
# Worker
# -------------------------------------------------------------
BSM_WORKER_INTERVAL=5
BSM_HEARTBEAT_STALE_AFTER=20
# Docker uniquement : port de l'interface sur 127.0.0.1 de l'hote.
# BSM_UI_PORT=8501

# -------------------------------------------------------------
# Risque / capital (valeurs par defaut, surchargeables dans Settings)
# -------------------------------------------------------------
BSM_QUOTE_ASSET=USDT
BSM_CAPITAL_RESERVE_PERCENT=20
BSM_MAX_RISK_PER_POSITION_PERCENT=1
BSM_MAX_TOTAL_RISK_PERCENT=5
BSM_MAX_OPEN_POSITIONS=5
BSM_MAX_EXPOSURE_PER_SYMBOL_PERCENT=25

# -------------------------------------------------------------
# Frais (estimation pour le break-even avec frais)
# -------------------------------------------------------------
BSM_TAKER_FEE_PERCENT=0.1
BSM_MAKER_FEE_PERCENT=0.1

# -------------------------------------------------------------
# Notifications (modules futurs — laisser vide desactive)
# -------------------------------------------------------------
BSM_TELEGRAM_BOT_TOKEN=
BSM_TELEGRAM_CHAT_ID=
BSM_SMTP_HOST=
BSM_SMTP_PORT=587
BSM_SMTP_USER=
BSM_SMTP_PASSWORD=
BSM_SMTP_FROM=
BSM_SMTP_TO=

# -------------------------------------------------------------
# Acces public (optionnel) : HTTPS automatique + un identifiant par personne (Caddy)
# L'interface n'a pas d'authentification propre : ne jamais l'exposer autrement.
# Ouvrir les ports 80 et 443 du serveur. Sans nom de domaine, utiliser
# <ip-avec-tirets>.sslip.io, qui pointe vers l'IP (ex. 62-84-177-241.sslip.io).
# Utilisateurs : make user-add NAME=<nom> (stockes dans deploy/users.caddy, hors Git).
# -------------------------------------------------------------
# COMPOSE_PROFILES=public
# BSM_PUBLIC_HOST=62-84-177-241.sslip.io
